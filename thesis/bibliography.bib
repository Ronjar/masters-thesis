@article{tuckerRedPhotographicInfrared1979,
  title = {Red and Photographic Infrared Linear Combinations for Monitoring Vegetation},
  author = {Tucker, Compton J.},
  year = 1979,
  month = may,
  journal = {Remote Sensing of Environment},
  volume = {8},
