@article{muringat.p.LandResettlementPostColonial2022,
  title = {Land {{Resettlement}} in {{Post-Colonial Zimbabwe}}: {{A Look}} into the {{Government Land Resettlement Approaches}}},
  author = {{Muringa T.P.} and {Zvaita G.T.}},
  year = 2022,
  month = dec,
  journal = {Journal of Inclusive Cities and Built Environment},
  volume = {2},
